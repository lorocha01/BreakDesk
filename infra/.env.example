# Domínio público apontando (registro A/AAAA) para este servidor
NEXO_DOMAIN=nexo.seudominio.com.br
# E-mail para o Let's Encrypt
ACME_EMAIL=ti@seudominio.com.br

# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
# Gere com: openssl rand -base64 48
JWT_SECRET=
# Gere com: openssl rand -hex 32 (compartilhado entre servidor e coturn)
TURN_SECRET=

# Somente se a VM estiver atrás de NAT 1:1 (AWS/GCP/Azure): IP público da máquina
TURN_EXTERNAL_IP=

# Origens permitidas (app desktop Tauri). Acrescente a URL do cliente web, se usar.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
LOG_LEVEL=info
