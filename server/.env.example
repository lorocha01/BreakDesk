# Ambiente: development | production | test
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://nexo:nexo@127.0.0.1:5432/nexo
# Obrigatório em produção (>= 32 caracteres aleatórios): openssl rand -base64 48
JWT_SECRET=
# Mesmo valor do static-auth-secret do coturn (>= 16 caracteres)
TURN_SECRET=
# Separados por vírgula
TURN_URLS=turn:turn.seudominio.com:3478?transport=udp,turn:turn.seudominio.com:3478?transport=tcp,turns:turn.seudominio.com:5349?transport=tcp
STUN_URLS=stun:turn.seudominio.com:3478
TURN_TTL_SEC=21600
# Origens permitidas (CORS e WebSocket). Padrão: origens do Tauri + localhost:1420/5173
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420
# Atrás de proxy reverso (Caddy): true ou lista de IPs/CIDRs confiáveis
TRUST_PROXY=false
# Aplica migrações ao iniciar
MIGRATE_ON_START=true
LOG_LEVEL=info
